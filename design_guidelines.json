{
  "design_system": {
    "identity": {
      "name": "Anchor Place",
      "tone": "Calm, Professional, Trustworthy, Accessible",
      "archetype": "Soft Utility",
      "theme_mode": "light"
    },
    "typography": {
      "font_family": {
        "headings": "Manrope, sans-serif",
        "body": "Inter, sans-serif",
        "accent": "Merriweather, serif"
      },
      "scale": {
        "h1": "text-4xl md:text-5xl font-bold tracking-tight",
        "h2": "text-3xl font-semibold tracking-tight",
        "h3": "text-2xl font-semibold",
        "body_lg": "text-lg leading-relaxed",
        "body_base": "text-base leading-relaxed",
        "caption": "text-sm text-slate-500"
      }
    },
    "colors": {
      "palette": {
        "primary": {
          "DEFAULT": "#0284c7",
          "foreground": "#ffffff",
          "hover": "#0369a1"
        },
        "secondary": {
          "DEFAULT": "#f0f9ff",
          "foreground": "#0f172a"
        },
        "background": "#ffffff",
        "surface": "#f8fafc",
        "text": {
          "primary": "#0f172a",
          "secondary": "#64748b",
          "muted": "#94a3b8"
        },
        "status": {
          "success": "#10b981",
          "warning": "#f59e0b",
          "error": "#ef4444",
          "info": "#3b82f6"
        }
      },
      "usage_rules": "Use primary blue for main actions. Use surface colors for card backgrounds. Text must always be Slate-900 for headings and Slate-600 for body to ensure high contrast."
    },
    "layout": {
      "spacing": {
        "container_padding": "p-6 md:p-12",
        "section_gap": "gap-8 md:gap-16",
        "card_padding": "p-6"
      },
      "grid_system": {
        "dashboard": "grid grid-cols-1 md:grid-cols-12 gap-6",
        "cards": "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
      },
      "radius": "rounded-xl"
    },
    "components": {
      "buttons": {
        "primary": "bg-primary text-primary-foreground hover:bg-primary/90 h-11 px-8 rounded-full shadow-sm transition-all hover:shadow-md",
        "secondary": "bg-white text-slate-700 border border-slate-200 hover:bg-slate-50 h-11 px-8 rounded-full transition-all",
        "ghost": "hover:bg-slate-100 text-slate-600 hover:text-slate-900"
      },
      "cards": {
        "base": "bg-white border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300 rounded-xl overflow-hidden",
        "interactive": "cursor-pointer hover:border-primary/20 hover:ring-2 hover:ring-primary/5"
      },
      "inputs": {
        "base": "h-11 bg-white border-slate-200 focus:border-primary focus:ring-2 focus:ring-primary/20 rounded-lg"
      }
    },
    "visual_enhancers": {
      "shadows": "shadow-[0_2px_8px_rgba(15,23,42,0.04)] hover:shadow-[0_8px_24px_rgba(15,23,42,0.08)]",
      "gradients": "bg-gradient-to-b from-slate-50 to-white",
      "glass": "bg-white/80 backdrop-blur-md border-b border-slate-200/50"
    },
    "motion": {
      "transition": "transition-all duration-300 ease-out",
      "hover_lift": "hover:-translate-y-1",
      "fade_in": "animate-in fade-in duration-500 slide-in-from-bottom-4"
    }
  },
