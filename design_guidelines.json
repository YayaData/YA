  "implementation_guide": {
    "pages": [
      {
        "name": "Welcome Screen",
        "path": "/",
        "layout": "Centered 'Concierge' layout. Large greeting text. Grid of 4 large action cards.",
        "key_elements": [
          "Hero Text: 'What do you need to do today?'",
          "Action Grid: 4 Cards (Place Client, List Placements, Learn, Explore Idea)",
          "No complex navigation bar on this screen - focus on choice."
        ]
      },
      {
        "name": "Place Client Form",
        "path": "/place-client",
        "layout": "Multi-step wizard (Stepper). Centered form container.",
        "key_elements": [
          "Step Indicator (1. Basics, 2. Needs, 3. Contact)",
          "Clear labels, no medical jargon",
          "Disclaimer: 'Do not enter PHI/Real Names'"
        ]
      },
      {
        "name": "Available Placements",
        "path": "/placements",
        "layout": "Filter sidebar (left) + Grid of placement cards (right).",
        "key_elements": [
          "Filters: Location, Type (IDD, Mental Health), Availability",
          "Cards: Facility Name, Type, Status Badge (Available/Full), 'Contact' button"
        ]
      }
    ],
    "universal_rules": [
      "Do not use gradients for text.",
      "Ensure all forms have validation states.",
      "Use 'sonner' for all toast notifications.",
      "All interactive elements must have data-testid attributes.",
      "Mobile responsiveness is critical - stack grids on mobile."
    ]
  }
}